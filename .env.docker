# Template for the Docker deployment — placeholders only, safe to commit.
# Copy real values from your VPS's existing backend/.env before first run.

PORT=5000
NODE_ENV=production
CLIENT_URL=https://admin.panjuintext.in

# MySQL runs on the VPS host, outside the container — host.docker.internal reaches it as long as
# the container is started with --add-host=host.docker.internal:host-gateway (see DOCKER-DEPLOYMENT.md).
DATABASE_URL="mysql://panju:REPLACE-WITH-DB-PASSWORD@host.docker.internal:3306/panjuintext"

JWT_SECRET=REPLACE-WITH-LONG-RANDOM-STRING
JWT_EXPIRES_IN=7d

# WhatsApp Web.js — the real Chrome installed in the image (see Dockerfile), not any host path
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
